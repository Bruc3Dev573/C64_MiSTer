// output sync monitor (tb/c64_tb.cpp sync_mon): video_sync outputs, the freezer
// outputs of video_mixer as the scaler and video_calc see them, the pause
// release watchdog, loads, the VIC raster position video_sync takes
public_flat_rd -module "emu" -var "hsync_out"
